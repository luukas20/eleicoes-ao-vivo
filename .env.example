# Copie para .env se quiser (o app lê variáveis de ambiente; nada aqui é segredo).
# Feed do TSE
TSE_BASE=https://resultados.tse.jus.br
TSE_AMBIENTE=oficial
# Vazio = descobrir as eleições pelo arquivo de configuração (EA11). Ex.: 6257,6259
TSE_ELEICOES=
# Cargos consultados (1 Presidente, 3 Governador, 5 Senador, 6 Dep. Federal, 7 Dep. Estadual, 8 Dep. Distrital)
CARGOS=1,3,5
# Identifique o projeto para o TSE (boa prática); inclua a URL do repositório
USER_AGENT=eleicoes-ao-vivo/0.1 (+https://github.com/luukas20/eleicoes-ao-vivo; painel nao oficial)

# Limites (o TSE permite 100 req/s por IP; mantenha bem abaixo)
MAX_RPS=15
WORKERS=8
# Multiplica os intervalos de consulta (use < 1 só contra o simulador local)
ESCALA_POLLING=1.0

# Servidor
HOST=127.0.0.1
PORT=8000
DESATUALIZADO_APOS_S=120
